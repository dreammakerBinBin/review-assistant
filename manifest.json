{
  "manifest_version": 3,
  "name": "Review Assistant",
  "version": "1.0.0",
  "description": "电商评价管理浏览器插件 - 高效管理评价回复，AI 智能生成",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
